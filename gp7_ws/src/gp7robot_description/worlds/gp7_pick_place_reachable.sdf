<?xml version="1.0"?>
<sdf version="1.9">
  <world name="gp7_pick_place">
    <physics name="gp7_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>5 5</size></plane></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.72 0.74 0.76 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Reachable demo layout. Box A at (0.5, 0.5, 0) as instructed by the lecturer; top centre is at 0.5, 0.5, 0.20 m. -->
    <model name="BoxA">
      <static>true</static>
      <pose>0.50 0.50 0.10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.30 0.30 0.20</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 0.30 0.20</size></box></geometry>
          <material>
            <ambient>0.10 0.30 0.85 1</ambient>
            <diffuse>0.10 0.30 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Box B starts at a fixed reachable location so the demo is repeatable. -->
    <model name="BoxB">
      
      <pose>0.35 0.25 0.025 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.125</mass>
          <inertia>
            <ixx>0.0000520833</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000520833</iyy><iyz>0</iyz><izz>0.0000520833</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.95 0.35 0.06 1</ambient>
            <diffuse>0.95 0.35 0.06 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
